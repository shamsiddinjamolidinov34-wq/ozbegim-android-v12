<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingBottom="12dp"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingBottom="12dp"
            android:text="@string/main_warning"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_enable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_enable" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_settings" />

        <Button
            android:id="@+id/btn_auto_translate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_details" />

        <Button
            android:id="@+id/btn_voices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_voices" />

        <Button
            android:id="@+id/btn_ai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_ai" />

        <Button
            android:id="@+id/btn_gestures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_gestures" />

        <Button
            android:id="@+id/btn_tutorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_tutorial" />

        <Button
            android:id="@+id/btn_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_test" />

        <Button
            android:id="@+id/btn_health"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_health" />

        <Button
            android:id="@+id/btn_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_log" />

        <Button
            android:id="@+id/btn_dictionary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_dictionary" />

        <Button
            android:id="@+id/btn_labels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_labels" />

        <Button
            android:id="@+id/btn_profiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_profiles" />

        <Button
            android:id="@+id/btn_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_backup" />

        <Button
            android:id="@+id/btn_contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_contact" />
    </LinearLayout>
</ScrollView>
