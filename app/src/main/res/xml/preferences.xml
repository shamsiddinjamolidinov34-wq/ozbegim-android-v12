<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_cat_speech">
        <Preference
            app:key="open_rate"
            app:title="@string/pref_rate" />
        <Preference
            app:key="open_pitch"
            app:title="@string/pref_pitch" />
        <ListPreference
            app:defaultValue="10"
            app:entries="@array/rate_step_entries"
            app:entryValues="@array/rate_step_values"
            app:key="rate_step"
            app:title="@string/pref_rate_step"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="auto"
            app:entries="@array/engine_entries"
            app:entryValues="@array/engine_values"
            app:key="engine_pref"
            app:title="@string/pref_engine"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:key="open_voices"
            app:title="@string/pref_voices" />
        <Preference
            app:key="open_details"
            app:summary="@string/pref_details_open_summary"
            app:title="@string/pref_details_open" />
        <ListPreference
            app:defaultValue="stop"
            app:entries="@array/mic_entries"
            app:entryValues="@array/mic_values"
            app:key="mic_policy"
            app:title="@string/pref_mic"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="standard"
            app:entries="@array/typing_entries"
            app:entryValues="@array/typing_values"
            app:key="typing_mode"
            app:title="@string/pref_typing"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="earcons"
            app:title="@string/pref_earcons" />
        <Preference
            app:key="open_tts_settings"
            app:title="@string/btn_tts_settings" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_speed">
        <ListPreference
            app:defaultValue="fast"
            app:entries="@array/speed_entries"
            app:entryValues="@array/speed_values"
            app:key="response_speed"
            app:summary="@string/pref_speed_summary"
            app:title="@string/pref_speed" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_gestures">
        <Preference
            app:key="open_gestures"
            app:title="@string/pref_gestures" />
        <ListPreference
            app:defaultValue="keyguard"
            app:entries="@array/two_finger_entries"
            app:entryValues="@array/two_finger_values"
            app:key="two_finger_pass"
            app:summary="@string/pref_two_finger_summary"
            app:title="@string/pref_two_finger" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_scripts">
        <ListPreference
            app:defaultValue="auto"
            app:entries="@array/script_entries"
            app:entryValues="@array/script_values"
            app:key="script_mode"
            app:title="@string/pref_script"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="auto"
            app:entries="@array/newlatin_entries"
            app:entryValues="@array/newlatin_values"
            app:key="new_latin_mode"
            app:title="@string/pref_new_latin"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="ascii"
            app:entries="@array/apostrophe_entries"
            app:entryValues="@array/apostrophe_values"
            app:key="apostrophe"
            app:title="@string/pref_apostrophe"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="adapt"
            app:entries="@array/bridge_entries"
            app:entryValues="@array/bridge_values"
            app:key="bridge_mode"
            app:title="@string/pref_bridge"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_translate">
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="auto_translate"
            app:summary="@string/pref_auto_translate_summary"
            app:title="@string/pref_auto_translate" />
        <ListPreference
            app:defaultValue="latin"
            app:entries="@array/translate_script_entries"
            app:entryValues="@array/translate_script_values"
            app:key="translate_script"
            app:title="@string/pref_translate_script"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="auto"
            app:entries="@array/translate_from_entries"
            app:entryValues="@array/translate_from_values"
            app:key="translate_from"
            app:title="@string/pref_translate_from"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="uz"
            app:entries="@array/translate_entries"
            app:entryValues="@array/translate_values"
            app:key="translate_to"
            app:title="@string/pref_translate_to"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:key="translate_info"
            app:selectable="false"
            app:summary="@string/pref_translate_info"
            app:title="@string/pref_translate_info_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_online">
        <Preference
            app:key="open_ai_settings"
            app:summary="@string/pref_ai_open_summary"
            app:title="@string/pref_ai_open" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_privacy">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="private_notifications"
            app:summary="@string/pref_private_summary"
            app:title="@string/pref_private" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/pref_cat_contact">
        <Preference
            app:key="open_contact"
            app:title="@string/btn_contact" />
    </PreferenceCategory>
</PreferenceScreen>
